# secrets and local config — only *.example files are committed
.env
*.env
!*.env.example

# python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# editors / os
.DS_Store
.idea/
.vscode/

# probe output — board content, never committed
probes/probe-report.json
probes/jira-probe-report.json
probes/confluence-probe-report.json
probes/plane-6c-probe-report.json
probes/jira-6c-probe-report.json

# real board configs (ids of live boards) — only examples/boards/*.example.toml is committed
/boards/

# conformance run records — board content, never committed
conformance/reports/

# raw session transcripts — board content; transcripts/*.md holds the committed summary
transcripts/raw/
